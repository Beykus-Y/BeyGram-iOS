load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:objc_library.bzl", "objc_library")

# google/re2 2025-11-05 (commit 927f5d53caf8111721e734cf24724686bb745f55), vendored unchanged. See README.md.
# The bridge in bridge/ gives Swift a C interface; no C++ type crosses it.

re2_sources = [
    "re2/bitmap256.cc",
    "re2/bitstate.cc",
    "re2/compile.cc",
    "re2/dfa.cc",
    "re2/filtered_re2.cc",
    "re2/mimics_pcre.cc",
    "re2/nfa.cc",
    "re2/onepass.cc",
    "re2/parse.cc",
    "re2/perl_groups.cc",
    "re2/prefilter.cc",
    "re2/prefilter_tree.cc",
    "re2/prog.cc",
    "re2/re2.cc",
    "re2/regexp.cc",
    "re2/set.cc",
    "re2/simplify.cc",
    "re2/tostring.cc",
    "re2/unicode_casefold.cc",
    "re2/unicode_groups.cc",
    "util/rune.cc",
    "util/strutil.cc",
]

cc_library(
    name = "re2",
    srcs = re2_sources,
    hdrs = glob([
        "re2/*.h",
        "util/*.h",
    ]),
    copts = [
        "-Ithird-party/re2",
        "-Ithird-party/webrtc/absl",
        "-DABSL_ALLOCATOR_NOTHROW=1",
    ],
    cxxopts = [
        "-std=c++17",
    ],
    deps = [
        "//third-party/webrtc/absl:absl_re2",
    ],
    visibility = [
        "//visibility:public",
    ],
)

cc_library(
    name = "bgre2",
    srcs = [
        "bridge/bgre2.cc",
    ],
    hdrs = [
        "bridge/bgre2.h",
    ],
    copts = [
        "-Ithird-party/re2",
        "-Ithird-party/webrtc/absl",
    ],
    cxxopts = [
        "-std=c++17",
    ],
    deps = [
        ":re2",
    ],
    visibility = [
        "//visibility:public",
    ],
)

objc_library(
    name = "BeyGramRE2",
    module_name = "BeyGramRE2",
    enable_modules = True,
    hdrs = [
        "bridge/bgre2.h",
    ],
    includes = [
        "bridge",
    ],
    deps = [
        ":bgre2",
    ],
    visibility = [
        "//visibility:public",
    ],
)
