"""Probes the active Xcode / iOS SDK capabilities at repository configuration time."""

def _parse_swift_version(version_output):
    for line in version_output.splitlines():
        marker = "Apple Swift version "
        idx = line.find(marker)
        if idx != -1:
            rest = line[idx + len(marker):]
            return rest.split(" ")[0].strip()
    return ""

def _xcode_capabilities_impl(repository_ctx):
    os_name = repository_ctx.os.name.lower()
    if "mac" not in os_name and "darwin" not in os_name:
        repository_ctx.file("BUILD.bazel", "")
        repository_ctx.file("capabilities.bzl", """# Non-macOS host
IOS_SDK_HAS_RESERVED_REGIONS = False
SWIFT_VERSION = ""
""")
        return

    developer_dir = repository_ctx.os.environ.get("DEVELOPER_DIR", "").strip()
    if not developer_dir:
        res = repository_ctx.execute(["/usr/bin/xcode-select", "-p"])
        if res.return_code == 0:
            developer_dir = res.stdout.strip()

    env = {"DEVELOPER_DIR": developer_dir} if developer_dir else {}

    swift_ver_res = repository_ctx.execute(
        ["/usr/bin/xcrun", "--sdk", "iphoneos", "swiftc", "--version"],
        environment = env,
    )
    swift_version = _parse_swift_version(swift_ver_res.stdout) if swift_ver_res.return_code == 0 else ""

    repository_ctx.file("probe_reserved_regions.swift", """import UIKit
@available(iOS 27.1, *)
func _beygramProbeReservedRegions(_ view: UIView) {
    _ = view.reservedRegions(kind: .occlusion)
}
""")
    probe_res = repository_ctx.execute(
        [
            "/usr/bin/xcrun",
            "--sdk",
            "iphoneos",
            "swiftc",
            "-typecheck",
            "-target",
            "arm64-apple-ios27.1",
            "probe_reserved_regions.swift",
        ],
        environment = env,
    )
    has_reserved_regions = (probe_res.return_code == 0)

    repository_ctx.file("BUILD.bazel", "")
    repository_ctx.file("capabilities.bzl", """# Auto-generated by xcode_capabilities repository rule.
IOS_SDK_HAS_RESERVED_REGIONS = {has_rr}
SWIFT_VERSION = "{swift_ver}"
""".format(
        has_rr = "True" if has_reserved_regions else "False",
        swift_ver = swift_version,
    ))

xcode_capabilities = repository_rule(
    implementation = _xcode_capabilities_impl,
    environ = ["DEVELOPER_DIR"],
    local = True,
)

